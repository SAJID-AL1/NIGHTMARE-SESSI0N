{
  "name": "Nightmare Bot",
  "description": "WhatsApp Multi Device Bot",
  "repository": "https://github.com/YOUR_USERNAME/Nightmare",
  "logo": "https://i.imgur.com/AfFp7pu.png",
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "nodejs"
  ],
  "env": {
    "SESSION_ID": {
      "description": "Paste your Session ID",
